# ─────────────────────────────────────────────────────────────
# ArkLife backend — environment variables
# Copy to backend/.env and fill in. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# Server
PORT=8000
NODE_ENV=development            # "production" on the server (required vars are then enforced)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=https://app.arklifeproject.com,http://localhost:3000

# Database (MongoDB, EU region)
MONGODB_URI=mongodb://localhost:27017/arklife

# Auth (use long random strings, e.g. `openssl rand -hex 48`)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (verification codes / password reset) — SMTP account
EMAIL_USER=
EMAIL_PASS=

# AI — Google Gemini (chat)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
CHAT_HISTORY_MESSAGES=16         # previous messages sent to the AI as conversation memory
CHAT_FULL_CONTEXT_CHARS=120000   # if all documents fit, send full text instead of excerpts

# Voice — ElevenLabs (voice cloning + text-to-speech)
ELEVENLABS_API_KEY=

# Avatar video — D-ID (optional; static photo works without it)
DID_API_KEY=

# Image hosting — Cloudinary (avatar photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Document OCR (self-hosted Tesseract; see README "OCR")
OCR_LANGS=ita+eng
OCR_DPI=200
OCR_MAX_PAGES=40
DOCUMENT_TIMEOUT_MS=600000
# TESSERACT_PATH=tesseract
# PDFTOPPM_PATH=pdftoppm

# Billing (keep false until real payments exist)
ALLOW_SELF_SUBSCRIPTION_CHANGE=false

# Legacy / unused (kept for reference)
# OPENAI_API_KEY=          # old embedding code, not called
# REPLICATE_API_TOKEN=     # test route removed
